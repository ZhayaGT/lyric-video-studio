# Inferhub — dipakai server untuk transkripsi lirik (audio → teks).
# Salin berkas ini menjadi .env lalu isi kuncinya. JANGAN commit .env.
#
# Tanpa kunci ini aplikasi tetap jalan: impor audio, LRC/manual, deteksi BPM,
# tap tempo, desain, dan ekspor MP4. Hanya transkripsi AI + "Rapikan teks" yang
# nonaktif (tombolnya dimatikan otomatis lewat /api/health).
INFERHUB_API_KEY=
INFERHUB_BASE_URL=https://api.inferhub.dev/v1

# Model yang menerima input audio (chat completions dengan input_audio).
# Alternatif: cp/cline-pass/mimo-v2.6-flash, cp/cline-pass/mimo-v2.6-pro
INFERHUB_AUDIO_MODEL=ali/qwen3.8-omni-flash

# Model teks: dipakai tombol "Rapikan teks" (ejaan/tanda baca).
INFERHUB_TEXT_MODEL=cb/deepseek-v4.1-flash
